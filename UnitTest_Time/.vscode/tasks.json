{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "Build_for_ARM",
      "command": "/usr/bin/arm-linux-gnueabihf-g++",
      "args": [
        "-std=c++26",
        "-g",
        "-Wall",
        "-I${workspaceFolder}",
        "-I${workspaceFolder}/../LIB.Utils",
        "${workspaceFolder}/main.cpp",
        "${workspaceFolder}/../LIB.Utils/utilsTest.cpp",
        "${workspaceFolder}/../LIB.Utils/utilsTime.cpp",
        "${workspaceFolder}/../LIB.Utils/utilsTime_Test.cpp",
        "-o",
        "${workspaceFolder}/unit_test_time"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "type": "shell",
      "label": "Build_for_PC",
      "command": "/usr/bin/g++",
      "args": [
        "-fdiagnostics-color=always",
        "-std=c++26",
        "-g",
        "-Wall",
        "-I${workspaceFolder}",
        "-I${workspaceFolder}/../LIB.Utils",
        "${workspaceFolder}/main.cpp",
        "${workspaceFolder}/../LIB.Utils/utilsTest.cpp",
        "${workspaceFolder}/../LIB.Utils/utilsTime.cpp",
        "${workspaceFolder}/../LIB.Utils/utilsTime_Test.cpp",
        "-o",
        "${workspaceFolder}/unit_test_time_dbg"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": "build",
      "detail": "compiler: /usr/bin/g++"
    }
  ]
}