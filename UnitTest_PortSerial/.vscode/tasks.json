{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "C/C++: cpp build active file ARM",
      "command": "/usr/bin/arm-linux-gnueabihf-g++-10",
      "args": [
        "-std=c++20",
        "-g",
        "-Wall",
        "-I${workspaceFolder}",
        "-I${workspaceFolder}/../LIB.Utils",
        "-I/usr/local/boost_1_77_0_ARM",
        "${workspaceFolder}/main.cpp",
        "${workspaceFolder}/../LIB.Utils/utilsPortSerial.cpp",
        "${workspaceFolder}/../LIB.Utils/utilsPortSerial_Test.cpp",
        "${workspaceFolder}/../LIB.Utils/utilsTest.cpp",
        "-o",
        "${workspaceFolder}/unit_test_portserial",
        "-lpthread"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "type": "cppbuild",
      "label": "C/C++: g++ build active file",
      "command": "/usr/bin/g++-11",
      "args": [
        "-fdiagnostics-color=always",
        "-std=c++20",
        "-g",
        "-Wall",
        "-I${workspaceFolder}",
        "-I${workspaceFolder}/../LIB.Utils",
        "-I/usr/local/boost_1_77_0_ARM",
        "${workspaceFolder}/main.cpp",
        "${workspaceFolder}/../LIB.Utils/utilsPortSerial.cpp",
        "${workspaceFolder}/../LIB.Utils/utilsPortSerial_Test.cpp",
        "${workspaceFolder}/../LIB.Utils/utilsTest.cpp",
        "-o",
        "${workspaceFolder}/unit_test_portserial_dbg",
        "-lpthread"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": "build",
      "detail": "compiler: /usr/bin/g++"
    }
  ]
}